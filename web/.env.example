# SMS Gateway - Environment Configuration
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin

# Veritabanı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smsgateway
DB_USER=smsgateway
DB_PASS=GÜÇLÜ_ŞİFRE_GİRİN

# Güvenlik
ADMIN_TOKEN=BURAYA_GÜÇLÜ_TOKEN_GİRİN
REGISTRATION_SECRET=BURAYA_KAYIT_ANAHTARI_GİRİN
CORS_ALLOWED_ORIGINS=https://yourdomain.com
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Uygulama
TIMEZONE=Europe/Istanbul
APP_ENV=production
APP_DEBUG=false
MAX_SMS_LENGTH=918
MAX_BULK_SIZE=500
SMS_RETRY_MAX=3
DEVICE_OFFLINE_THRESHOLD=300
APP_URL=https://yourdomain.com
